# Copia este archivo a .env.local y completa los valores.
# En Supabase: Project → Connect → "Connection string" (ORMs / Prisma).

# App (y Vercel): Transaction pooler, puerto 6543.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Migraciones y carga de datos: Session pooler, puerto 5432 (no se usa en Vercel).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Ticket gratuito de la API de Mercado Público (opcional).
# Solicítalo en https://api.mercadopublico.cl/modules/Participa.aspx
MERCADOPUBLICO_TICKET=

# Carpeta para descargas de las fuentes (por defecto ./data)
# RISKTANK_DATA_DIR=
